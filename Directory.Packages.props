<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Gerenciamento central de versao de pacotes (ManagePackageVersionsCentrally=true acima): todo
    <PackageReference> nos .csproj individuais NAO leva Version — a versao vem so daqui. Sprint
    Engine (2026-08-08) e a primeira a usar pacotes NuGet de verdade.
  -->
  <ItemGroup>
    <PackageVersion Include="LibVLCSharp" Version="3.9.0" />
    <PackageVersion Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />

    <!--
      Sprint Crossfade v2 (2026-08-11, mesmo dia da reversão da v1): NAudio só pro
      CartucheiraVideo.Engine/AudioEngine.cs (as duas Cartucheiras, Vinhetas/Trilhas) — ver o
      comentário completo no topo de AudioEngine.cs sobre por que o LibVLCSharp foi trocado ali.
      O Deck (PlaybackEngine, NDI) continua 100% LibVLCSharp, intocado.
    -->
    <PackageVersion Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
