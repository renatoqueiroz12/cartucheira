<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Conjunto de ícones da aplicação, todo via Path/Geometry — sem SVG externo, sem imagem
        embutida (pedido explícito do usuário na aprovação da Sprint 6: aplicação leve). Cada
        entrada é uma Geometry num canvas 24x24, consumida assim:

            <Path Data="{StaticResource Icon.Play}" Fill="{StaticResource Brush.TextHi}" />

        Ícones "de contorno" (settings, folder, search, clock, calendar, grid, list, chevron-right,
        circle, alert, wifi-off, loader, volume, film, move-h) são desenhados para Stroke; ícones
        "sólidos" (play, pause, stop, flag, check, check-circle, x, plus, star, flame) para Fill —
        comentado em cada um.

        Substitui todo emoji da interface (decisão fechada na rodada de mockup v4 — ver
        status-implementacao.md).
    -->

    <!-- Fill -->
    <Geometry x:Key="Icon.Play">M7,4 L19,12 L7,20 Z</Geometry>

    <!-- Fill -->
    <Geometry x:Key="Icon.Pause">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</Geometry>

    <!-- Fill -->
    <Geometry x:Key="Icon.Stop">M5,5 L19,5 L19,19 L5,19 Z</Geometry>

