<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Único ThemeDictionary da aplicação (aprovado na Sprint 6, arquitetura §12/item 17).

        Sprint 7 (arquitetura/especificacao-visual.md — consolidação definitiva da identidade
        visual): repaginado com a paleta exata pedida pelo usuário e estendido pra cobrir TODOS os
        controles WPF usados (ou que podem vir a ser usados) na aplicação, não só os que já
        apareciam nas telas — o objetivo é que nenhum controle novo "nasça" com aparência padrão do
        Windows sem alguém precisar lembrar de estilizá-lo depois.

        Mudança de fundo (pedido explícito do usuário, Sprint 7): toda Brush.* referenciada fora
        deste arquivo agora usa DynamicResource, não StaticResource — permite trocar/ajustar o tema
        em tempo de execução no futuro (ex.: um tema Light) trocando só este dicionário, sem tocar
        XAML de tela nenhuma. As Color.* internas (usadas só aqui dentro, pra construir os Brush.*)
        continuam StaticResource — não há necessidade de indireção runtime num valor que só é lido
        na definição do próprio Brush. FontSize.* e Size.* também continuam StaticResource: a regra
        de DynamicResource do usuário foi especificamente sobre CORES.

        Nomenclatura: Brush.* para pincéis, FontSize.* para tamanhos de texto, Size.* para
        dimensões de controles. Os 6 tons de cinza (Bg0-Bg5) mapeiam 1:1 nos 6 papéis nomeados da
        especificação visual — o mapeamento está comentado abaixo de cada um; os nomes Bg0-Bg5 não
        foram trocados pelos nomes em português pra não obrigar uma renomeação arriscada em todas as
        telas que já os referenciam desde a Sprint 6.
    -->

    <!-- ===================== Paleta base (fundo) — mapeamento 1:1 com a especificação visual ===================== -->
    <!-- Bg0: mais fundo que "Background principal" — usado só em superfícies "afundadas" (área de preview do Deck, caixa de miniatura) que precisam ler como uma tela, não um painel. Extensão do usuário não nomeada explicitamente na paleta de 6 cores. -->
    <Color x:Key="Color.Bg0">#FF0A0A0A</Color>
    <!-- Bg1 = "Background principal" da especificação visual -->
    <Color x:Key="Color.Bg1">#FF111111</Color>
    <!-- Bg2 = "Painéis" -->
    <Color x:Key="Color.Bg2">#FF1A1A1A</Color>
    <!-- Bg3 = "Cards" (também usado como superfície de inputs — TextBox/ComboBox/miniatura) -->
    <Color x:Key="Color.Bg3">#FF222222</Color>
    <!-- Bg4 = "Hover" -->
    <Color x:Key="Color.Bg4">#FF2B2B2B</Color>
    <!-- Bg5 = "Selecionado" -->
    <Color x:Key="Color.Bg5">#FF303030</Color>

    <SolidColorBrush x:Key="Brush.Bg0" Color="{StaticResource Color.Bg0}" />
    <SolidColorBrush x:Key="Brush.Bg1" Color="{StaticResource Color.Bg1}" />
    <SolidColorBrush x:Key="Brush.Bg2" Color="{StaticResource Color.Bg2}" />
    <SolidColorBrush x:Key="Brush.Bg3" Color="{StaticResource Color.Bg3}" />
    <SolidColorBrush x:Key="Brush.Bg4" Color="{StaticResource Color.Bg4}" />
    <SolidColorBrush x:Key="Brush.Bg5" Color="{StaticResource Color.Bg5}" />

    <!-- ===================== Linhas/bordas ===================== -->
    <!-- "Bordas" da especificação visual — valor idêntico ao que já existia (nenhuma mudança necessária). -->
    <SolidColorBrush x:Key="Brush.Line" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.LineSoft" Color="#FF2A2A2A" />

    <!-- ===================== Texto ===================== -->
    <!-- TextHi = "Texto principal" e TextMid = "Texto secundário" da especificação visual (valores exatos). TextLow/TextFaint são uma extensão pra hierarquia mais fina (rótulos pequenos, textos quase invisíveis) — mesma família de cinza, não uma cor nova. -->
    <SolidColorBrush x:Key="Brush.TextHi" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.TextMid" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Brush.TextLow" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#FF5C5C5C" />

    <!-- ===================== Cores semânticas (paleta reduzida, fora da Botoneira) — valores exatos da especificação visual ===================== -->
    <SolidColorBrush x:Key="Brush.Blue" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="Brush.Green" Color="#FF2DBE60" />
    <SolidColorBrush x:Key="Brush.Red" Color="#FFD84545" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#FFE3B341" />
    <!-- Vermelho escuro, reservado pro estado de Erro do Deck (distinto do vermelho de ON AIR) — pedido do
         usuário na negociação da Sprint 7; valor exato não veio especificado, este é um tom derivado
         (mais escuro/dessaturado que Brush.Red) pra ficar claramente diferente a olho nu. Ajustável se o
         usuário quiser outro tom. -->
    <SolidColorBrush x:Key="Brush.ErrorDark" Color="#FF8C3A3A" />

    <!-- ===================== Gradientes vívidos — Play/Pause/Stop do Deck (Sprint Mockup-v9-Deck-Buttons, 2026-09-21) =====================
         Pedido explícito do usuário ("play, pause e stop são os principais botões, use cores mais
         vivas") — validado ao longo de várias rodadas do mockup HTML v9 antes desta implementação
         real. Em vez de tocar em Brush.Green/Brush.Red/Brush.Amber (usados em vários outros lugares —
         status dots do vMix/Resolume, barra de RAM, borda de Deck pausado — e que NÃO fizeram parte
         da aprovação deste mockup), estes são recursos novos, exclusivos dos três botões principais
         de transporte. Cada um é um LinearGradientBrush (topo mais claro -> base mais escura, 180°),
         igual ao efeito do mockup aprovado; DynamicResource como todo Brush.* do tema (regra da
         Sprint 7), então continuam trocáveis num tema futuro sem mexer em XAML de tela. -->
    <LinearGradientBrush x:Key="Brush.PlayGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1FDB6D" Offset="0" />
        <GradientStop Color="#FF0FA855" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PauseGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFC229" Offset="0" />
        <GradientStop Color="#FFF5A100" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.StopGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFF4557" Offset="0" />
        <GradientStop Color="#FFE01F35" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== Cor nos botões secundários do Deck (Sprint Mockup-v9-Ajustes-Pós-Teste, 2026-09-21) =====================
         Pedido explícito do usuário depois de rodar a v1.0.49 de verdade: "vamos colocar cor nos
         outros botoes dos deck nao deixar preto" — Clear/Loop/Next/Preview estavam todos no mesmo
         cinza neutro (Brush.Bg4), lendo como "preto". Cada um ganha uma cor de identidade própria,
         sempre num tom SUAVE (fundo translúcido ~14% + borda ~40%, ícone/texto sólido) pra não
         competir com o Play/Pause/Stop (que continuam sendo os três com preenchimento sólido/vívido
         — "os principais botões", pedido original da rodada #1 do mockup). Violeta e ciano são cores
         novas de uso geral (antes só existiam como Brush.Pad.Purple/Brush.Pad.Cyan, específicas da
         Botoneira) — mesmos valores exatos, reaproveitados aqui pra manter a paleta consistente em
         vez de inventar um tom novo. -->
    <SolidColorBrush x:Key="Brush.Violet" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="#FF06B6D4" />

    <SolidColorBrush x:Key="Brush.RedSoft" Color="#24D84545" />
    <SolidColorBrush x:Key="Brush.RedLine" Color="#66D84545" />
    <SolidColorBrush x:Key="Brush.VioletSoft" Color="#248B5CF6" />
    <SolidColorBrush x:Key="Brush.VioletLine" Color="#668B5CF6" />
    <SolidColorBrush x:Key="Brush.BlueSoft" Color="#242D7DFF" />
    <SolidColorBrush x:Key="Brush.BlueLine" Color="#662D7DFF" />
    <SolidColorBrush x:Key="Brush.CyanSoft" Color="#2406B6D4" />
    <SolidColorBrush x:Key="Brush.CyanLine" Color="#6606B6D4" />

    <!-- ===================== Cores da Botoneira (exceção à paleta reduzida — mockup v4/v5/v7) =====================
         Blue/Red/Green/Amber realinhados aos valores exatos da especificação visual (Sprint 7), pra a
         Botoneira usar a mesma base de cor do resto da aplicação. Purple/Pink/Cyan são só da Botoneira —
         sem equivalente na paleta reduzida, mantidos como estavam. -->
    <SolidColorBrush x:Key="Brush.Pad.Blue" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="Brush.Pad.Red" Color="#FFD84545" />
    <SolidColorBrush x:Key="Brush.Pad.Green" Color="#FF2DBE60" />
    <SolidColorBrush x:Key="Brush.Pad.Amber" Color="#FFE3B341" />
    <SolidColorBrush x:Key="Brush.Pad.Purple" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Brush.Pad.Pink" Color="#FFEC4899" />
    <SolidColorBrush x:Key="Brush.Pad.Cyan" Color="#FF06B6D4" />

    <!-- Scrim semi-transparente atrás do número do pad (badge no canto). -->
    <SolidColorBrush x:Key="Brush.PadBadgeScrim" Color="#AA000000" />

    <!-- Contorno sutil de hover do pad da Botoneira (especificação visual §7: "hover", "sombra muito leve") — branco translúcido, não é uma cor semântica nova, só um realce de estado. -->
    <SolidColorBrush x:Key="Brush.PadHoverOutline" Color="#40FFFFFF" />

    <!-- Texto dentro do cartucho (duração + nome) — Sprint Cartucheira 2, parte 2, ajuste (2026-08-10):
         pedido explícito do usuário pra trocar de Brush.TextHi (quase branco) pra preto, já que o
         fundo do pad é sempre uma cor saturada da paleta acima (Blue/Red/Green/Amber/Purple/Pink/
         Cyan), nunca um dos tons escuros de Bg — preto rende mais legível/contrastado ali do que em
         cima do fundo escuro do resto da tela, onde Brush.TextHi continua sendo a escolha certa. -->
    <SolidColorBrush x:Key="Brush.PadText" Color="#FF000000" />

    <!-- ===================== Estado ON AIR (Deck em execução, enviando pra alguma saída) =====================
         Sprint 7 fecha o item 1 do backlog de polimento visual (v7): o vermelho de ON AIR agora É o
         "Vermelho" da paleta nova (#FFD84545) — mais escuro/dessaturado que o #FFEF4444 anterior, sem
         precisar de uma cor extra só pra isso. Regra completa de quando cada cor de borda do Deck se
         aplica está em MainWindow.xaml / DeckViewModel.VisualState (arquitetura visual §8). -->
    <SolidColorBrush x:Key="Brush.OnAir" Color="#FFD84545" />
    <SolidColorBrush x:Key="Brush.OnAirBg" Color="#FF241515" />

    <!-- ===================== Tamanhos de fonte ===================== -->
    <sys:Double x:Key="FontSize.Micro">10</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <!-- Meta (segunda linha do Explorer): 12 -> 13 na Sprint 8, pedido explícito de legibilidade a
         maior distância ("nome dos arquivos deve ser facilmente legível"). -->
    <sys:Double x:Key="FontSize.Meta">13</sys:Double>
    <!-- Nome do arquivo no Explorer: 16 -> 17 na Sprint 8, mesmo pedido acima. -->
    <sys:Double x:Key="FontSize.ListName">17</sys:Double>
    <sys:Double x:Key="FontSize.Label">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">18</sys:Double>
    <sys:Double x:Key="FontSize.DeckFileName">20</sys:Double>
    <sys:Double x:Key="FontSize.PadDuration">18</sys:Double>
    <sys:Double x:Key="FontSize.PadLabel">10.5</sys:Double>
    <!-- Número do pad (badge no canto) — Sprint 8: "número grande" (especificação visual, ajustes
         finais). Continua um badge de canto, não o elemento dominante do pad (esse papel é da
         duração, decisão da v7 mantida), mas maior/mais legível que os 12px da Sprint 7. -->
    <sys:Double x:Key="FontSize.PadNumber">14</sys:Double>

    <!-- ===================== Tamanhos de controle ===================== -->
    <!-- 34 -> 30 na Sprint 8: Decks cedem um pouco de altura pro preview de vídeo crescer (prioridade
         Explorer > Decks > Botoneira, especificação dos "ajustes finais"). -->
    <sys:Double x:Key="Size.TransportButtonHeight">30</sys:Double>
    <sys:Double x:Key="Size.ExplorerTreeMinWidth">120</sys:Double>
    <sys:Double x:Key="Size.ExplorerTreeMaxWidth">360</sys:Double>
    <!-- Aumentada de 158 pra 190 na Sprint 7, e de 190 pra 210 na Sprint 8 (Explorer prioridade #1,
         "largura útil" pedida explicitamente nos ajustes finais). -->
    <sys:Double x:Key="Size.ExplorerTreeDefaultWidth">210</sys:Double>
    <!-- Miniatura do Explorer — 96x54 (Sprint 7) -> 108x60 (Sprint 8), mesmo pedido de área útil
         maior. Espaço reservado — ainda sem imagem real (depende do Engine/LibVLC). -->
    <sys:Double x:Key="Size.ExplorerThumbnailWidth">108</sys:Double>
    <sys:Double x:Key="Size.ExplorerThumbnailHeight">60</sys:Double>
    <!-- Badge do número do pad na Botoneira — 22 (Sprint 7) -> 26 (Sprint 8, "número grande"). -->
    <sys:Double x:Key="Size.PadNumberBadge">26</sys:Double>

    <!-- ===================== Estilos globais implícitos (TargetType, sem x:Key) =====================
         Aplicados automaticamente a qualquer instância desses controles na aplicação inteira.

         Sprint 7 amplia a cobertura pra fechar o item 1 da especificação visual ("nenhum componente
         pode usar o tema padrão do Windows"): além do que já existia (Window/TextBox/Button/CheckBox/
         ComboBox/Slider/ScrollBar/ProgressBar), entram agora RadioButton, TreeView/TreeViewItem,
         ListBox/ListBoxItem, ContextMenu/MenuItem/Menu, ToolTip, Separator e GridViewColumnHeader.

         Nota sobre "Popup" (item 1 da especificação visual): Popup não é um Control — não tem
         Background/Template próprios pra estilizar via TargetType. O que carrega a aparência dele é o
         conteúdo colocado dentro (a Border escura do ComboBox já tem isso; o ToolTip, que também usa
         Popup internamente, ganha template próprio abaixo). Não existe uma "lacuna" de Popup deixada
         sem tema — é que Popup em si não é o lugar onde a cor vive. -->

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg1}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMid}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- TextBox: template próprio com suporte a placeholder (Tag = texto do placeholder, pedido explícito
         do usuário pro campo de busca do Explorer — "placeholder cinza"). -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.TextLow}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: superfície própria (Bg3) com hover trocando pra Bg4 — identidade própria em vez de só opacidade. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: caixa quadrada própria com check em Path/Geometry — nunca a caixa padrão do Windows. -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMid}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                Background="{DynamicResource Brush.Bg3}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.TextHi}"
                                  StrokeThickness="2.2" Stretch="Uniform" Margin="2.5" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Blue}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton: novo na Sprint 7 (não usado ainda na aplicação, mas pedido explicitamente na lista de controles a temati zar). Círculo próprio, mesmo padrão visual do CheckBox. -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMid}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="15" Height="15" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Line}" StrokeThickness="1"
                                     Fill="{DynamicResource Brush.Bg3}" />
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Brush.Blue}"
                                     Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar: trilho e polegar simplificados, escuros, com hover azul (pedido explícito da especificação visual). -->
    <Style x:Key="Theme.ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.Bg5}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ScrollViewer "solto" (usado direto numa tela, fora do template interno de TextBox/ListBox/
        TreeView/ComboBox, que já herdam o Background do próprio controle): sem este estilo, o
        ScrollViewer cai no branco padrão do tema nativo do Windows por trás do conteúdo — foi o que
        causou o retângulo branco visível atrás da Botoneira, achado pelo usuário rodando de verdade
        no Windows (a única captura de tela real que revelou isso; nada neste sandbox Linux consegue
        renderizar WPF pra pegar esse tipo de falha visual). Transparent, não um Brush do tema — o
        objetivo aqui é só deixar de pintar por cima do que já está atrás (o Background da tela/
        Window, já escuro), não impor uma cor própria.
    -->
    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg2}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Theme.ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: template escuro completo (Setters simples de Background/Foreground não alcançam o Popup/ComboBoxItem nativos). -->
    <Style x:Key="Theme.ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{DynamicResource Brush.Bg3}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush.TextLow}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Bg5}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Style="{StaticResource Theme.ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Brush.Bg3}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="260">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: trilho escuro, sem polegar visível.
         Sprint Deck-Seek-Bar-Fix (2026-09-15): trilho 4px -> 6px e polegar 12px -> 16px, a pedido do
         usuário ("aumentar um pouco essa barra").
         Sprint Mockup-v9-Deck-Buttons (2026-09-21): trilho 6px -> 12px e o polegar (bolinha azul)
         SAIU visualmente — pedido explícito do usuário no mockup aprovado ("barra ta muito fininha e
         a bolinha redonda nela tb tira, deixa só barra e possibilidade de ir com o mouse andando").
         O Thumb continua existindo no template (Fill Transparent, mesmo tamanho de antes) em vez de
         virar Visibility="Collapsed": o WPF resolve clique-em-qualquer-ponto-do-Track
         (IsMoveToPointEnabled) e o arraste contínuo capturando o mouse NO PRÓPRIO Thumb por baixo dos
         panos — removê-lo da árvore visual (Collapsed) quebraria esse mecanismo; só ficar invisível
         (Transparent) entrega exatamente o pedido (sem bolinha visível, arraste continua funcionando
         em qualquer ponto da barra) sem mexer no code-behind de seek (MainWindow.xaml.cs,
         inalterado). Único Slider do projeto (a barra de execução do Deck), então este estilo global
         é seguro de ajustar sem afetar mais nada. -->
    <Style x:Key="Theme.SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Width="16" Height="16" Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="12" Background="{DynamicResource Brush.Bg5}" CornerRadius="6" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{DynamicResource Brush.Blue}" Height="12">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="{DynamicResource Brush.Blue}" Height="12" CornerRadius="6" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <!-- Sprint Deck-Seek-Bar (2026-09-12): faltava este lado — sem ele, o Track nao tinha
                                 nenhum elemento clicavel a DIREITA do polegar (o Border de fundo, sozinho, nao conta
                                 como parte do Track pra fins de clique-pra-mover/IsMoveToPointEnabled). So existia
                                 problema agora porque nenhum Slider deste projeto era interativo antes desta sprint
                                 (o unico uso ate aqui era puramente visual, decorativo, nunca clicado de verdade).
                                 Background Transparent (nao ausente) de proposito: uma Brush transparente ainda
                                 registra hit-test no WPF, a AUSENCIA de Background que nao registra — deixa o Border
                                 cinza de fundo (Brush.Bg5) aparecer por baixo normalmente. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="Transparent" Height="12">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" Height="12" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Theme.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg5}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===================== TreeView (novo na Sprint 7) =====================
         Expander próprio (Icon.ChevronRight rotacionado 90° quando expandido) em vez do triângulo
         padrão do Windows — pedido explícito ("nada do TreeView padrão", especificação visual §3). -->
    <Style x:Key="Theme.TreeExpanderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <!--
                        Terceira abordagem pra rotação da seta — histórico completo em
                        status-implementacao.md ("Correção pós-entrega", Sprint 7):
                          1ª: Setter.TargetName mirando direto no RotateTransform (x:Name num
                              Freezable) — TargetName só resolve FrameworkElement, não compilou.
                          2ª: Setter.Property composto "RenderTransform.(RotateTransform.Angle)"
                              mirando no Path — não compilou também.
                          3ª: Binding direto (IsChecked -> Angle via conversor) com
                              RelativeSource=TemplatedParent no RotateTransform.Angle — compilou
                              tudo (Core e o resto do Presentation), mas o Presentation falhou só
                              nesta única linha com MC4106 "não é possível resolver a Propriedade
                              de Modelo 'Angle'": o otimizador do compilador de XAML tenta resolver
                              Binding+RelativeSource=TemplatedParent contra uma tabela de
                              "propriedades de template" do TargetType (ToggleButton) — e falha
                              porque Angle não é propriedade do ToggleButton, é da RotateTransform,
                              um objeto que só existe pendurado no RenderTransform do Path.
                        4ª (esta, definitiva): em vez de mexer numa sub-propriedade de dentro do
                        RotateTransform (por Setter ou por Binding), o Trigger troca o Path.
                        RenderTransform INTEIRO por um RotateTransform novo — Setter.TargetName
                        mirando "Arrow" (o Path, um FrameworkElement de verdade) e
                        Property="RenderTransform" (propriedade direta do Path, sem caminho
                        composto nenhum). É o padrão clássico do WPF pra esse tipo de ícone
                        (usado, por exemplo, no glifo padrão do Expander em vários temas) —
                        não depende de TargetName em Freezable, não depende de caminho de
                        propriedade composto, e não aciona a otimização de TemplateBinding que
                        quebrou a tentativa anterior.
                    -->
                    <Grid Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Brush.TextLow}"
                              StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press"
                                              Style="{StaticResource Theme.TreeExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg5}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ListBox (lista de arquivos do Explorer) — novo estilo global na Sprint 7 =====================
         Antes, só a instância no FileExplorerPanel tinha Background/BorderThickness ajustados inline;
         o ListBoxItem ficava sem estilo (seleção/hover azul-claro padrão do Windows). Agora é global. -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg5}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ContextMenu / MenuItem / Menu (novos na Sprint 7) =====================
         Estilo propositalmente simples (sem submenu/ícone/atalho) — suficiente pra um menu plano.
         Sprint Cartucheira 2, parte 2 - correção (2026-08-10): o menu de cor/loop do cartucho
         (MainWindow.xaml) tentou usar um MenuItem com filhos (submenu "Cor") — como este
         ControlTemplate não tem Popup/ItemsPresenter nenhum pra hospedar um flyout, o submenu
         renderizava cortado/quebrado. Removido o submenu de lá (virou um diálogo de cor nativo do
         Windows) em vez de construir suporte a submenu aqui — mantém a regra "ganha mais template se
         algum dia precisar de hierarquia" (ainda não precisa). IsChecked ganhou feedback visual
         (Background) nesta correção, já que o item "Loop" é IsCheckable e o ContentPresenter sozinho
         não desenha nenhum símbolo de marcado. -->
    <!-- (comentário histórico da Sprint 7, mantido: "Nada usa isso ainda na aplicação — entram por
         pedido explícito da especificação visual (item 1)" — hoje já está em uso, ver acima.) -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
    </Style>

    <!--
        Sprint Cartucheira 2, parte 2 - correção (2026-08-10) #2: o texto dos itens ("Cor...", "Loop")
        abria invisível — só aparecia depois de passar o mouse por cima. Causa: o Foreground do
        MenuItem vinha só do Setter de Style acima, resolvido via DynamicResource, e o ContentPresenter
        do Header (aqui embaixo) não tinha Foreground nenhum setado explicitamente nele — dependia só
        da herança de propriedade (TextElement.Foreground) descendo da árvore visual até o TextBlock
        que o WPF gera sozinho pro Header (que é uma string simples). O ContextMenu/MenuItem é
        hospedado dentro de um Popup (ver ContextMenu acima e o Popup do ComboBox nesta mesma folha) —
        Popup cria uma sub-árvore visual separada, e nesse app o próprio XAML de tela já precisa
        rebindar manualmente o DataContext do ContextMenu (MainWindow.xaml, "PlacementTarget.
        DataContext") porque a herança normal não atravessa o Popup — a mesma desconexão afeta a
        herança de Foreground: no primeiro paint do Popup, a herança as vezes não resolve a tempo (só
        resolve depois que ALGO força o WPF a reavaliar o template, como o Trigger IsHighlighted que já
        muda o Background no hover — por isso "aparece só passando o mouse"). Correção: parar de
        depender de herança pra este valor — TextElement.Foreground é setado direto no Border via
        TemplateBinding, um valor já resolvido no MenuItem no momento em que o template é aplicado
        (não uma nova busca de DynamicResource dentro da sub-árvore do Popup), e desce garantido pro
        TextBlock que o ContentPresenter gera pro Header.
    -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="3" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                        </Trigger>
                        <!-- Sprint Cartucheira 2, parte 2 - correção (2026-08-10): feedback visual pra MenuItem IsCheckable (ex.: "Loop" do cartucho) — sem isso, marcado/desmarcado não tinha nenhuma diferença visível. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ToolTip (novo na Sprint 7) =====================
         Já era usado (Deck/Configurações/itens da lista) e caía no balão branco padrão do Windows —
         uma das lacunas reais que apareceu nas capturas de tela. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg4}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Separator (novo na Sprint 7) ===================== -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ===================== GridViewColumnHeader (novo na Sprint 7) =====================
         Não usado ainda (a lista do Explorer é um ListBox, não ListView/GridView), mas pedido
         explicitamente na lista de "Headers" a tematizar — fica pronto se um GridView entrar depois. -->
    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

</ResourceDictionary>
