<Window x:Class="CartucheiraVideo.Presentation.Views.AdminAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CartucheiraVideo.Presentation.Converters"
        Title="{Binding Title}"
        Height="240" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <!--
        Sprint Config Geral, parte 1 (2026-08-09) — mesmo padrão de diálogo pequeno do
        RenameBankWindow (DialogResult=true/false, botão padrão via IsDefault). PasswordBox não
        aceita Binding direto em Password (restrição de segurança do próprio controle do WPF) —
        por isso os dois campos são acessados por nome no code-behind (PasswordChanged), igual ao
        RenameBankWindow acessa NameTextBox por nome em vez de binding.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Senha" Foreground="{DynamicResource Brush.TextLow}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Confirmar senha" Foreground="{DynamicResource Brush.TextLow}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"
                   Visibility="{Binding IsSetPasswordMode, Converter={StaticResource BoolToVis}}" />
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3" PasswordChanged="ConfirmPasswordBox_PasswordChanged" Margin="0,0,0,12"
                     Visibility="{Binding IsSetPasswordMode, Converter={StaticResource BoolToVis}}" />

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Red}" FontSize="{StaticResource FontSize.Small}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Padding="8" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Confirmar" Width="90" Padding="8" Click="Confirm_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
