<UserControl x:Class="CartucheiraVideo.Presentation.Views.CartridgeSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sprint Cartucheira (2026-08-09, parte 2 do item 2 do roteiro): terceira seção da janela de
        Configurações, ao lado de Deck 1/Deck 2 — hospedada como DataContext="{Binding CartridgeSettings}"
        dentro do SettingsWindow, mesmo padrão do DeckSettingsPanel (mas sem abas — só duas seções
        fixas, Vinhetas/Trilhas, mais o campo de comando externo).

        Style.FieldLabel/Style.FieldGroup redefinidos aqui (não compartilhados com
        DeckSettingsPanel.xaml) de propósito: Resources de um UserControl são locais a ele mesmo,
        redefinir é o padrão já estabelecido nesse projeto pra manter cada UserControl autocontido
        (ver comentário equivalente em DeckSettingsPanel.xaml).
    -->
    <UserControl.Resources>
        <Style x:Key="Theme.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Theme.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="Theme.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Vinhetas -->
            <TextBlock Text="Vinhetas" Style="{StaticResource Theme.SectionTitle}" />
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Dispositivo de saída de áudio" Style="{StaticResource Theme.FieldLabel}" />
                <ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding VinhetasAudioDeviceId}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Crossfade entre cartuchos (ms)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding VinhetasCrossfadeMs, UpdateSourceTrigger=PropertyChanged}" Tag="0" HorizontalAlignment="Left" Width="100" />
                <TextBlock Text="0 = corte seco (padrão). Com um valor maior, ao disparar um cartucho novo enquanto outro toca, os dois se misturam por esse tempo em vez de cortar na hora."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Pasta raiz dos programas" Style="{StaticResource Theme.FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0" Tag="nenhuma pasta escolhida"
                              Text="{Binding VinhetasFolderPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Escolher..." Padding="10,6" Command="{Binding BrowseVinhetasFolderCommand}" />
                </Grid>
                <TextBlock Text="Cada subpasta direta desta pasta vira um programa na Cartucheira (ex.: &quot;Jornal 18h&quot;, &quot;Esporte Show&quot;); os áudios dentro de cada subpasta viram os cartuchos daquele programa, em ordem alfabética (ex.: &quot;01 - abertura.mp3&quot;, &quot;02 - encerramento.mp3&quot;...). Áudios soltos direto nesta pasta raiz não aparecem."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Trilhas -->
            <TextBlock Text="Trilhas" Style="{StaticResource Theme.SectionTitle}" />
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Dispositivo de saída de áudio" Style="{StaticResource Theme.FieldLabel}" />
                <ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding TrilhasAudioDeviceId}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Crossfade entre cartuchos (ms)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding TrilhasCrossfadeMs, UpdateSourceTrigger=PropertyChanged}" Tag="0" HorizontalAlignment="Left" Width="100" />
                <TextBlock Text="0 = corte seco (padrão). Com um valor maior, ao disparar um cartucho novo enquanto outro toca, os dois se misturam por esse tempo em vez de cortar na hora."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Pasta raiz dos programas" Style="{StaticResource Theme.FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0" Tag="nenhuma pasta escolhida"
                              Text="{Binding TrilhasFolderPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Escolher..." Padding="10,6" Command="{Binding BrowseTrilhasFolderCommand}" />
                </Grid>
                <TextBlock Text="Mesma regra da pasta raiz de Vinhetas: subpastas viram programas, áudios dentro delas viram cartuchos."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Comando externo por teclado/Stream Deck/mesa de áudio — Sprint Comando Externo
                (2026-08-10), arquitetura §14.2/§13/§13.4. Um único toggle por Cartucheira liga os
                TRÊS canais juntos (atalho de teclado global, o endpoint HTTP daquela Cartucheira
                pro Stream Deck/Companion, E o par Ligar/Desligar UDP da mesa de áudio real) — pedido
                original do usuário foi "a opção... por teclado e por stream deck", no singular; o
                canal UDP (correção pós-entrega desta mesma data, protocolo confirmado por captura de
                tela da tela de configuração real da mesa) entrou no mesmo toggle por ser a mesma
                ideia — mais um jeito externo de disparar a mesma Cartucheira. Os três canais são
                controlados de ponta a ponta por este projeto, sem bloqueio de protocolo de
                terceiro, então já disparam de verdade (MainViewModel.TryTriggerExternally/
                TryTriggerExternalUdpCommand / AudioBankViewModel.TriggerExternalCommand/
                StopExternalCommand) assim que o toggle é ligado e salvo — nenhum é placeholder.
            -->
            <TextBlock Text="Comando externo — Vinhetas" Style="{StaticResource Theme.SectionTitle}" />
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <CheckBox Content="Receber comando externo por teclado, Stream Deck/Companion e mesa de áudio (UDP)" IsChecked="{Binding VinhetasExternalTriggerEnabled}" Margin="0,0,0,12" />
                <TextBlock Text="Atalho de teclado global" Style="{StaticResource Theme.FieldLabel}" />
                <ComboBox ItemsSource="{Binding KeyboardShortcuts}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding VinhetasKeyboardShortcut}" IsEnabled="{Binding VinhetasExternalTriggerEnabled}" />
                <TextBlock Text="Endpoint HTTP para Stream Deck/Companion (ação &quot;Website&quot;/&quot;HTTP Request&quot;, método POST)" Style="{StaticResource Theme.FieldLabel}" Margin="0,12,0,6" />
                <TextBox Text="{Binding VinhetasEndpointUrl, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Text="Porta UDP da mesa de áudio (compartilhada com Trilhas e os dois Decks — mesmo campo dos dois)" Style="{StaticResource Theme.FieldLabel}" Margin="0,12,0,6" />
                <TextBox Text="{Binding SharedUdpPort.Port, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: 8888" HorizontalAlignment="Left" Width="120" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SharedUdpPort.EndpointDisplay}" Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Texto que dispara (&quot;Trigger ON&quot; na mesa)" Style="{StaticResource Theme.FieldLabel}" />
                        <TextBox Text="{Binding VinhetasUdpTriggerOnCommand, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: ON" IsEnabled="{Binding VinhetasExternalTriggerEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Texto que para (&quot;Trigger OFF&quot; na mesa)" Style="{StaticResource Theme.FieldLabel}" />
                        <TextBox Text="{Binding VinhetasUdpTriggerOffCommand, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: OFF" IsEnabled="{Binding VinhetasExternalTriggerEnabled}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Teclado/Stream Deck disparam o &quot;1&quot; da fila de cartuchos selecionados na Botoneira — se ele já estiver tocando, interrompe e toca o próximo da fila (arquitetura §14.6). O texto de &quot;Ligar&quot; da mesa faz o mesmo; o de &quot;Desligar&quot; só para o que estiver tocando, sem tocar nada novo. Campo de texto vazio = aquele comando específico fica sem efeito. Comando ignorado, sem efeito, se nenhum cartucho estiver selecionado ou se o toggle acima estiver desligado."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Comando externo — Trilhas" Style="{StaticResource Theme.SectionTitle}" />
            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <CheckBox Content="Receber comando externo por teclado, Stream Deck/Companion e mesa de áudio (UDP)" IsChecked="{Binding TrilhasExternalTriggerEnabled}" Margin="0,0,0,12" />
                <TextBlock Text="Atalho de teclado global" Style="{StaticResource Theme.FieldLabel}" />
                <ComboBox ItemsSource="{Binding KeyboardShortcuts}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding TrilhasKeyboardShortcut}" IsEnabled="{Binding TrilhasExternalTriggerEnabled}" />
                <TextBlock Text="Endpoint HTTP para Stream Deck/Companion (ação &quot;Website&quot;/&quot;HTTP Request&quot;, método POST)" Style="{StaticResource Theme.FieldLabel}" Margin="0,12,0,6" />
                <TextBox Text="{Binding TrilhasEndpointUrl, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Text="Porta UDP da mesa de áudio (compartilhada com Vinhetas e os dois Decks — mesmo campo dos dois)" Style="{StaticResource Theme.FieldLabel}" Margin="0,12,0,6" />
                <TextBox Text="{Binding SharedUdpPort.Port, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: 8888" HorizontalAlignment="Left" Width="120" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SharedUdpPort.EndpointDisplay}" Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Texto que dispara (&quot;Trigger ON&quot; na mesa)" Style="{StaticResource Theme.FieldLabel}" />
                        <TextBox Text="{Binding TrilhasUdpTriggerOnCommand, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: ON1" IsEnabled="{Binding TrilhasExternalTriggerEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Texto que para (&quot;Trigger OFF&quot; na mesa)" Style="{StaticResource Theme.FieldLabel}" />
                        <TextBox Text="{Binding TrilhasUdpTriggerOffCommand, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: OFF1" IsEnabled="{Binding TrilhasExternalTriggerEnabled}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mesma regra de Vinhetas acima, pra fila de Trilhas — lembre de usar um texto DIFERENTE do configurado em Vinhetas e nos Decks (a porta UDP é a mesma pra tudo, quem diferencia é sempre o texto)."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
