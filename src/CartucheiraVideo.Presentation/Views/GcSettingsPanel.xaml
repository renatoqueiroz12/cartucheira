<UserControl x:Class="CartucheiraVideo.Presentation.Views.GcSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CartucheiraVideo.Presentation.ViewModels">

    <!--
        Sprint GC (2026-11-17): nona seção da janela de Configurações — conexão com o Título do GC
        no vMix (Host/Porta/Título/Canal de Overlay, DELIBERADAMENTE separados da aba vMix de cada
        Deck — ver comentário de classe de GcSettingsSnapshot), qual Deck é "o apresentador" pro GC
        de Laudas sem VT, e a lista "Campos do GC" do mockup configurável do monitoramento remoto
        (mesmo layout Lista+botões Adicionar/Remover de BackgroundArtSettingsPanel.xaml, com mais
        colunas numéricas de posição/tamanho).
    -->
    <UserControl.Resources>
        <Style x:Key="Theme.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Theme.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="Theme.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="GC (Gerador de Caracteres)" Style="{StaticResource Theme.SectionTitle}" />
            <TextBlock Text="A Cartucheira manda o GC pro vMix usando o Título (GT) já cadastrado lá — não existe nenhum GC desenhado por esta tela. Preencha abaixo qual vMix/Título recebe, habilite, e cadastre os campos que o seu Título usa (precisam casar com os nomes reais do Título no vMix) pra desenhar o monitoramento remoto."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <CheckBox Content="Habilitar disparo automático de GC pro vMix" IsChecked="{Binding Enabled}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Host do vMix (IP ou nome)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding VMixHost, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Porta da API HTTP do vMix" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding VMixPort, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Título (Input) do GC no vMix — número ou nome cadastrado" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Canal de Overlay do vMix (1 a 8) onde o Título entra/sai" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding OverlayChannel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Deck fonte (pro GC automático de Laudas sem VT — Entrevista/Nota/Passagem)" Style="{StaticResource Theme.FieldLabel}" />
                <ComboBox ItemsSource="{Binding SourceDeckOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SourceDeckSetting}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Campos do GC (mockup do monitoramento remoto)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBlock Text="Posição/tamanho aproximados (pixels, numa tela de referência 1920x1080) de cada campo — a dashboard web desenha estes retângulos com o VALOR atual de cada campo, ao vivo. Não é uma imagem real do vMix (a API do vMix não oferece isso pela rede) — é só uma aproximação visual, igual a ideia por trás do espelho do Teleprompter."
                           Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nome do campo" Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                    <TextBlock Grid.Column="1" Text="X" Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                    <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                    <TextBlock Grid.Column="3" Text="Larg." Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                    <TextBlock Grid.Column="4" Text="Alt." Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                    <TextBlock Grid.Column="5" Text="Fonte" Style="{StaticResource Theme.FieldLabel}" Margin="4,0,0,4" />
                </Grid>
                <ListBox ItemsSource="{Binding FieldLayout}" SelectedItem="{Binding SelectedField}" MaxHeight="260"
                         BorderThickness="1" BorderBrush="{DynamicResource Brush.LineSoft}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GcFieldLayoutItemViewModel}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" Tag="nome do campo" />
                                <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="2" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="3" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="4" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="5" Text="{Binding FontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Novo campo" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddFieldCommand}" />
                    <Button Content="Remover selecionado" Padding="10,6" Command="{Binding RemoveFieldCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
