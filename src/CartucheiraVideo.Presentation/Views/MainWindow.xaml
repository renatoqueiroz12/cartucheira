                    </Grid>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.LineSoft}" Margin="18,0" />

                <!-- Metade direita: Trilhas -->
                <StackPanel Grid.Column="2" DataContext="{Binding TrilhasBank}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold" Foreground="{DynamicResource Brush.TextHi}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding CountLabel}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextLow}" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Voltar" Command="{Binding BackCommand}" Margin="0,0,6,0"
                                Visibility="{Binding IsInsideProgram, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="4" Content="Renomear" Command="{Binding RenameCommand}" Margin="0,0,6,0" />
                        <Button Grid.Column="5" Content="Recarregar" Command="{Binding ReloadCommand}" />
                    </Grid>
                    <!--
                        Barra de execução (Sprint Cartucheira 2, parte 2, 2026-08-10) — mesma
                        estrutura da metade Vinhetas, ver comentário lá (Sprint Mockup-v9-Ajustes-
                        Pós-Teste-2, 2026-09-21: sempre visível, cronômetro mais proeminente).
                    -->
                    <Border Background="{DynamicResource Brush.Bg4}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding NowPlaying.Name}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNowPlaying}" Value="False">
                                                    <Setter Property="Text" Value="Nada tocando" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Value="{Binding NowPlaying.Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                                             Height="6" Margin="0,4,0,0" Foreground="{DynamicResource Brush.OnAir}" />
                            </StackPanel>

                            <!-- Cronômetro — badge escuro com contagem regressiva ao vivo. -->
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Bg0}" CornerRadius="4" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSize.Label}" FontWeight="Black" FontFamily="Consolas" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding NowPlaying.DurationDisplay}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNowPlaying}" Value="False">
                                                    <Setter Property="Text" Value="00:00" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Mesma estrutura de duas grades (programas/cartuchos) da metade Vinhetas — ver comentário lá. -->
                    <Grid MinHeight="164">
                        <Grid Visibility="{Binding IsInsideProgram, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Nenhum programa encontrado — verifique a pasta raiz em Configurações → Cartucheira."
                                       Visibility="{Binding HasPrograms, Converter={StaticResource InverseBoolToVis}}"
                                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Small}"
                                       TextWrapping="Wrap" VerticalAlignment="Top" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="164" Background="Transparent"
                                          Visibility="{Binding HasPrograms, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Programs}"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding OpenCommand}" Margin="5" Height="74" Style="{StaticResource Theme.ProgramCard}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Grid Visibility="{Binding IsInsideProgram, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nenhum cartucho de áudio encontrado nesta pasta."
                                       Visibility="{Binding HasButtons, Converter={StaticResource InverseBoolToVis}}"
                                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Small}"
                                       TextWrapping="Wrap" VerticalAlignment="Top" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="164" Background="Transparent"
                                          Visibility="{Binding HasButtons, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Buttons}"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                Sprint Cartucheira 2, parte 2 (2026-08-10): clique
                                                esquerdo continua tocando/parando (PlayAudioCommand,
                                                inalterado). Clique direito é interceptado em
                                                PreviewMouseRightButtonDown (MainWindow.xaml.cs) —
                                                sem Ctrl vira seleção (IsSelected, e.Handled=true,
                                                cancela o menu); com Ctrl deixa o ContextMenu abrir
                                                normalmente (Cor/Loop).

                                                Correção pós-entrega (2026-08-10): usuário reportou
                                                clique ESQUERDO (sem Ctrl) também selecionando E
                                                abrindo a janela de Cor/Loop ao mesmo tempo, rodando
                                                de verdade no Windows — não bate com nenhum caminho
                                                de código deste arquivo (só o botão direito do mouse,
                                                interceptado acima, abre esse ContextMenu). Trava
                                                defensiva adicionada, cobrindo QUALQUER gesto que
                                                possa abrir o ContextMenu (clique direito, tecla
                                                Aplicativos/Shift+F10, gesto de "pressionar e segurar"
                                                de touchpad/touchscreen promovido a clique direito
                                                pelo Windows, etc.): ContextMenuOpening
                                                (PadButton_ContextMenuOpening) cancela a abertura
                                                sempre que Ctrl não está pressionado naquele instante
                                                — última trava, depois de qualquer outra lógica.
                                            -->
                                            <Button Command="{Binding PlayAudioCommand}" Margin="5" Height="74" Style="{StaticResource Theme.PadButton}"
                                                    PreviewMouseRightButtonDown="PadButton_PreviewMouseRightButtonDown"
                                                    ContextMenuOpening="PadButton_ContextMenuOpening">
                                                <Button.ContextMenu>
                                                    <!--
                                                        Sprint Cartucheira 2, parte 2 - correção
                                                        (2026-08-10): o antigo submenu "Cor" (7
                                                        swatches, um MenuItem dentro do outro) saiu —
                                                        era o menu "cortado" que o usuário reportou.
                                                        Causa raiz: o ControlTemplate de MenuItem em
                                                        Theme.xaml é deliberadamente simples (Border +
                                                        ContentPresenter só do Header, ver comentário
                                                        lá) — sem Popup/ItemsPresenter pra submenu,
                                                        então um MenuItem com filhos não tinha onde
                                                        renderizar o flyout, e o WPF tentava desenhar
                                                        um popup degenerado. "Cor..." agora abre um
                                                        seletor de cor nativo do Windows
                                                        (System.Windows.Forms.ColorDialog, cores
                                                        básicas) via ColorMenuItem_Click no
                                                        code-behind — pedido explícito do usuário.
                                                    -->
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Cor..." Click="ColorMenuItem_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Loop" IsCheckable="True" IsChecked="{Binding IsLoopEnabled, Mode=OneWay}" Command="{Binding ToggleLoopCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteudo: Decks (esquerda) | Explorer (direita) — 50/50 (mockup v8, nota #7). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="440" />
                <ColumnDefinition Width="1*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- Deck 1 / Deck 2 — dividem toda a altura da coluna (mockup v8, nota #14: sem mais a Fila Rapida competindo por espaco). -->
            <ItemsControl Grid.Column="0" Margin="16,16,8,8" ItemsSource="{Binding Decks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Sprint Mockup-v9-Ajustes-Pós-Teste (2026-09-21): borda padrão (sem
                            nenhum estado especial ativo) virou Transparent — usuário reportou,
                            rodando de verdade, uma linha clara visível contornando cada card de
                            Deck o tempo todo. A separação entre cards agora vem só do contraste de
                            fundo (Brush.Bg3 sobre Brush.Bg1), igual ao resto da Cartucheira e ao
                            padrão de software de broadcast profissional (vMix/OBS/Resolume) citado
                            na especificação visual. A borda colorida continua aparecendo, do jeito
                            que sempre apareceu, só nos estados reais abaixo (ON AIR/local/pausado/
                            erro/drag-over) — nenhum desses Triggers foi tocado.
                        -->
                        <Border Margin="0,0,0,10" Background="{DynamicResource Brush.Bg3}" CornerRadius="8" Padding="18,14"
                                BorderThickness="2" BorderBrush="Transparent"
                                AllowDrop="True"
                                DragEnter="DeckBorder_DragEnter"
                                DragLeave="DeckBorder_DragLeave"
                                Drop="DeckBorder_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnAir}" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.OnAirBg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLocalOnly}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorDark}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="120" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    Cabecalho fino: nome, ON AIR, Auto/Manual, pills de destino
                                    (somente leitura) — mockup v8, nota #9. Sprint Config Geral,
                                    parte 1 (2026-08-09): a engrenagem por Deck que existia aqui
                                    foi REMOVIDA — configuração de Deck agora é só pelo botão
                                    "Configurações" da barra superior (janela única, protegida por
                                    senha de admin), não mais um atalho por card.
                                -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextMid}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <Border Grid.Column="1" Background="{DynamicResource Brush.OnAir}" CornerRadius="3" Padding="8,4" Margin="0,0,10,0"
                                            Visibility="{Binding IsOnAir, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ON AIR" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold" Foreground="{DynamicResource Brush.TextHi}" />
                                    </Border>

                                    <!-- Auto/Manual (mockup v8, nota #13). -->
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.Bg4}" CornerRadius="14" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Auto" Command="{Binding SetAutoModeCommand}" Padding="12,5" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Manual" Command="{Binding SetManualModeCommand}" Padding="12,5" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoMode}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pills de destino vMix/Resolume — somente leitura (mockup v8, nota #8: configuracao real fica a cargo da engrenagem, quando existir). -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0">
                                        <Border Background="{DynamicResource Brush.Bg4}" CornerRadius="10" Padding="8,4" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SendToVMix}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Green}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="vMix" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMid}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Brush.Bg4}" CornerRadius="10" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SendToResolume}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Green}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="Resolume" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMid}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Linha central: preview a esquerda, 6 botoes de transporte quadrados a direita (mockup v8, notas #9/#10/#17). -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource Brush.Bg0}" CornerRadius="5" ClipToBounds="True">
                                        <Grid>
                                            <vlc:VideoView MediaPlayer="{Binding VideoPlayer}" />
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                       FontSize="{StaticResource FontSize.Body}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowStatusOverlay, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!--
                                        Reestruturado no mockup v9 (aprovado 2026-09-21, várias
                                        rodadas de ajuste direto com o usuário — ver
                                        arquitetura/sprint-2026-09-21-mockup-v9-deck-buttons.md):
                                        UniformGrid Columns="7" (7 botões iguais) virou um Grid 4x2
                                        assimétrico. Play é o botão principal (ocupa as duas linhas,
                                        coluna mais larga, cor viva); Pause/Stop empilhados numa
                                        coluna ao lado (também cores vivas — "os três principais");
                                        Clear/Loop/Next/Preview em grade 2x2, menores e neutros. As
                                        larguras de coluna (1.4*/0.85*/0.85*/0.85*) e as margens
                                        (8px horizontal, 4px vertical) reproduzem as proporções do
                                        mockup HTML validado pelo usuário nas últimas rodadas de
                                        feedback.
                                    -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.85*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Play — botão principal, ocupa as duas linhas. Gradiente vívido novo (Brush.PlayGradient, Theme.xaml) a pedido explícito do usuário ("cores mais vivas"). -->
                                        <Button Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Command="{Binding PlayCommand}"
                                                Style="{StaticResource Theme.DeckBigButton}" Margin="0,0,8,0"
                                                Background="{DynamicResource Brush.PlayGradient}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Play}" Fill="#FF0A0A0A" Width="28" Height="28" Stretch="Uniform" Margin="0,0,0,8" />
                                                <TextBlock Text="Play" FontSize="{StaticResource FontSize.Label}" FontWeight="Black" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Pause — empilhado com o Stop ao lado do Play. Gradiente vívido novo (Brush.PauseGradient). -->
                                        <Button Grid.Column="1" Grid.Row="0" Command="{Binding PauseCommand}"
                                                Style="{StaticResource Theme.DeckBigButton}" Margin="0,0,8,4"
                                                Background="{DynamicResource Brush.PauseGradient}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Pause}" Fill="#FF0A0A0A" Width="18" Height="18" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Pause" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Stop — embaixo do Pause. Gradiente vívido novo (Brush.StopGradient). -->
                                        <Button Grid.Column="1" Grid.Row="1" Command="{Binding StopCommand}"
                                                Style="{StaticResource Theme.DeckBigButton}" Margin="0,4,8,0"
                                                Background="{DynamicResource Brush.StopGradient}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Stop}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Stop" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!--
                                            Clear/Loop/Next/Preview ganharam cor própria na Sprint
                                            Mockup-v9-Ajustes-Pós-Teste (2026-09-21) — pedido
                                            explícito do usuário depois de testar a v1.0.49 de
                                            verdade ("vamos colocar cor nos outros botoes dos deck
                                            nao deixar preto"). Cada um com um tom suave (fundo
                                            translúcido + borda + ícone/texto sólido, ver Theme.xaml)
                                            pra não competir com o preenchimento vívido/sólido de
                                            Play/Pause/Stop, que continuam sendo os três principais.
                                        -->

                                        <!-- Clear (ajustes de Deck, 2026-08-09): esvazia o Deck de vez, tira a midia do Engine tambem (diferente do Stop, que so volta a posicao pro inicio). Vermelho suave — ação destrutiva. -->
                                        <Button Grid.Column="2" Grid.Row="0" Command="{Binding ClearCommand}"
                                                Margin="0,0,8,4" Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.RedLine}" BorderThickness="1"
                                                Style="{StaticResource Theme.DeckBigButton}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.X}" Stroke="{DynamicResource Brush.Red}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Clear" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold" Foreground="{DynamicResource Brush.Red}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Loop — violeta suave quando inativo; ativo continua solido azul (trigger inalterado). -->
                                        <Button Grid.Column="3" Grid.Row="0" Command="{Binding ToggleLoopCommand}" Margin="0,0,0,4" BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Theme.DeckBigButton}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.VioletSoft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.VioletLine}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Violet}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LoopEnabled}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Repeat}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Loop" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Next — azul suave. -->
                                        <Button Grid.Column="2" Grid.Row="1" Command="{Binding NextCommand}"
                                                Margin="0,4,8,0" Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.BlueLine}" BorderThickness="1"
                                                Style="{StaticResource Theme.DeckBigButton}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.SkipForward}" Fill="{DynamicResource Brush.Blue}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Next" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Preview — ciano suave. -->
                                        <Button Grid.Column="3" Grid.Row="1" Command="{Binding PreviewCommand}"
                                                Margin="0,4,0,0" Background="{DynamicResource Brush.CyanSoft}" BorderBrush="{DynamicResource Brush.CyanLine}" BorderThickness="1"
                                                Style="{StaticResource Theme.DeckBigButton}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Eye}" Stroke="{DynamicResource Brush.Cyan}" StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" Margin="0,0,0,3" />
                                                <TextBlock Text="Preview" FontSize="{StaticResource FontSize.Micro}" FontWeight="Bold" Foreground="{DynamicResource Brush.Cyan}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Faixa inferior: nome do arquivo, progresso, tempos (mockup v8, nota #9). -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding LoadedFileName}" />
                                                <Setter Property="FontSize" Value="{StaticResource FontSize.DeckFileName}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                                        <Setter Property="Text" Value="Vazio — arraste um vídeo aqui" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Sprint Deck-Seek-Bar (2026-09-12): Slider interativo (clique ou arraste avança/retrocede
                                         o vídeo) no lugar da antiga ProgressBar só-visual — pedido explícito do usuário
                                         ("coloque a opção na barra de execução para que eu possa avançar o video"). Ver
                                         SeekSlider_PreviewMouseLeftButtonUp no code-behind (MainWindow.xaml.cs) pro
                                         racional completo.
                                         Sprint Deck-Seek-Bar-Fix (2026-09-15): PreviewMouseLeftButtonDown/LostMouseCapture
                                         novos — congelam as atualizações de posição vindas do Engine enquanto durar o
                                         arraste (ver DeckViewModel.BeginSeekDrag/EndSeekDrag), corrigindo o bug reportado
                                         de a barra não deixar voltar (arrastar pra trás brigava com o tick de posição real,
                                         que só anda pra frente). Altura e polegar também aumentados (pedido do usuário:
                                         "aumentar um pouco essa barra") — ver Theme.xaml (estilo global do Slider). -->
                                    <Slider Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                                            IsMoveToPointEnabled="True" IsEnabled="{Binding HasVideo}"
                                            Height="22" Margin="0,8,0,5"
                                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                            LostMouseCapture="SeekSlider_LostMouseCapture" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Sprint Deck-Seek-Bar-Fix (2026-09-15): FontSize.Small (11px) -> FontSize.Meta
                                             (13px, mesmo tamanho já usado pra duração/resolução/codec no FileExplorerPanel)
                                             — pedido do usuário ("o tempo tb esta muito pequeno"). -->
                                        <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" FontSize="{StaticResource FontSize.Meta}" Foreground="{DynamicResource Brush.TextLow}" />
                                        <!-- Sprint Deck-Seek-Bar (2026-09-12): duração TOTAL do arquivo, junto do tempo
                                             restante — pedido explícito do usuário ("mostre tb o time frame"). Antes desta
                                             sprint só existiam tempo decorrido (esquerda) e tempo restante (aqui), nunca a
                                             duração total do arquivo carregado. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding RemainingTime}" FontSize="{StaticResource FontSize.Meta}" Foreground="{DynamicResource Brush.TextLow}" />
                                            <TextBlock Text=" / " FontSize="{StaticResource FontSize.Meta}" Foreground="{DynamicResource Brush.TextLow}" />
                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSize.Meta}" Foreground="{DynamicResource Brush.TextLow}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Explorer / Playlist -->
            <Border Grid.Column="1" Margin="8,16,16,8" Background="{DynamicResource Brush.Bg2}" CornerRadius="6" ClipToBounds="True">
                <views:FileExplorerPanel DataContext="{Binding FileExplorer}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
