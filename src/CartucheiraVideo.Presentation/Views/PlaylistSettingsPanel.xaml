<UserControl x:Class="CartucheiraVideo.Presentation.Views.PlaylistSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sprint Playlist-Dashboard (2026-11-14): sétima seção da janela de Configurações, ao lado de
        Deck 1/Deck 2/Cartucheira/Saídas Livewire/Rede NDI/Arte de Fundo. Mesmo padrão de
        Style.FieldLabel/FieldGroup/SectionTitle redefinidos localmente já usado pelos outros
        painéis desta janela.
    -->
    <UserControl.Resources>
        <Style x:Key="Theme.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Theme.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="Theme.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Playlist" Style="{StaticResource Theme.SectionTitle}" />
            <TextBlock Text="Dashboard web pra produtores organizarem o que vai ao ar, por Programa e Data. Sprint 1: só cria Programa/Data e a pasta real no disco — ingest de vídeo e disparo de GC entram em sprints seguintes."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Pasta raiz (vazia = módulo desligado)" Style="{StaticResource Theme.FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Escolher pasta..." Command="{Binding BrowseRootFolderCommand}" Padding="10,6" />
                </Grid>
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Porta da dashboard (precisa ser alcançável por outros computadores da rede local)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding DashboardPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="URL pra passar aos produtores" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding DashboardUrlDisplay, Mode=OneWay}" IsReadOnly="True" />
            </StackPanel>

            <TextBlock Text="SEM autenticação nesta v1 — qualquer computador na mesma rede local da Cartucheira consegue abrir essa URL e criar/ver Programas e Datas, mesmo princípio já aceito hoje pro vMix/NDI/Resolume (rede de estúdio, não exposta à internet)."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="Bold" />
            <TextBlock Text="Depois de salvar com uma porta nova, o Windows pode pedir permissão de Administrador (UAC) uma vez, pra liberar essa porta no Firewall."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
