<UserControl x:Class="CartucheiraVideo.Presentation.Views.PlaylistSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CartucheiraVideo.Presentation.Converters">

    <!--
        Sprint Playlist-Dashboard (2026-11-14): sétima seção da janela de Configurações, ao lado de
        Deck 1/Deck 2/Cartucheira/Saídas Livewire/Rede NDI/Arte de Fundo. Mesmo padrão de
        Style.FieldLabel/FieldGroup/SectionTitle redefinidos localmente já usado pelos outros
        painéis desta janela.
    -->
    <UserControl.Resources>
        <Style x:Key="Theme.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Theme.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="Theme.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Sprint 5 (2026-11-16, Usuários da Dashboard) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Playlist" Style="{StaticResource Theme.SectionTitle}" />
            <TextBlock Text="Dashboard web pra produtores organizarem o que vai ao ar, por Programa e Data. Sprint 1: só cria Programa/Data e a pasta real no disco — ingest de vídeo e disparo de GC entram em sprints seguintes."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Pasta raiz (vazia = módulo desligado)" Style="{StaticResource Theme.FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Escolher pasta..." Command="{Binding BrowseRootFolderCommand}" Padding="10,6" />
                </Grid>
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="Porta da dashboard (precisa ser alcançável por outros computadores da rede local)" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding DashboardPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Style="{StaticResource Theme.FieldGroup}">
                <TextBlock Text="URL pra passar aos produtores" Style="{StaticResource Theme.FieldLabel}" />
                <TextBox Text="{Binding DashboardUrlDisplay, Mode=OneWay}" IsReadOnly="True" />
            </StackPanel>

            <TextBlock Text="Desde a Sprint 5, a dashboard exige login — ver &quot;Usuários da Dashboard&quot; abaixo pra criar o primeiro Administrador. Continua só pra rede local do estúdio (não exposta à internet), mesmo princípio já aceito hoje pro vMix/NDI/Resolume."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="Bold" />
            <TextBlock Text="Depois de salvar com uma porta nova, o Windows pode pedir permissão de Administrador (UAC) uma vez, pra liberar essa porta no Firewall."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Usuários da Dashboard" Style="{StaticResource Theme.SectionTitle}" Margin="0,24,0,10" />
            <TextBlock Text="Crie aqui o primeiro usuário Administrador (acesso total) antes de passar a URL pro produtor. O Admin entra na própria dashboard web e, se quiser, cria os demais usuários (Produtores) por aqui também, liberando pra cada um só os Programas que ele deve ver/editar. Grava direto no disco a cada ação — não depende do &quot;Salvar&quot; desta janela."
                       Foreground="{DynamicResource Brush.TextFaint}" FontSize="{StaticResource FontSize.Micro}" Margin="0,0,0,12" TextWrapping="Wrap" />

            <TextBlock Text="Salve a pasta raiz acima (e feche/reabra Configurações) antes de criar usuários."
                       Foreground="{DynamicResource Brush.Red}" FontSize="{StaticResource FontSize.Small}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding HasPersistedRootFolder, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="Nenhum Administrador cadastrado ainda — crie o primeiro usuário abaixo marcando &quot;Administrador&quot; antes de passar a URL pro produtor."
                       Foreground="{DynamicResource Brush.TextHi}" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding ShowNoAdminYetHint, Converter={StaticResource BoolToVis}}" />

            <ListBox ItemsSource="{Binding DashboardUsers}" SelectedItem="{Binding SelectedDashboardUser}" Height="140" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Username}" FontWeight="Bold" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding RoleDisplay}" Foreground="{DynamicResource Brush.TextLow}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="+ Novo usuário" Command="{Binding AddDashboardUserCommand}" Padding="10,6" Margin="0,0,8,0" />
                <Button Content="Editar" Command="{Binding EditDashboardUserCommand}" Padding="10,6" Margin="0,0,8,0" />
                <Button Content="Remover" Command="{Binding RemoveDashboardUserCommand}" Padding="10,6" />
            </StackPanel>

            <TextBlock Text="{Binding DashboardUsersError}" Foreground="{DynamicResource Brush.Red}" FontSize="{StaticResource FontSize.Small}"
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding DashboardUsersError, Converter={StaticResource StringToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
