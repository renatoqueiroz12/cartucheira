<Window x:Class="CartucheiraVideo.Presentation.Views.ScreenOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartucheira Vídeo — Saída de Tela"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Black">

    <!--
        Sprint Telas-Saida-Direta (2026-11-10): janela sem conteúdo nenhum de UI — só uma imagem
        preenchendo a tela inteira, pensada pra ficar sentada por cima de um monitor físico ligado
        na placa de vídeo do PC (o "telão"). Sem DataContext/Binding de propósito: quem controla o
        quadro exibido é DeckViewModel chamando SetFrame diretamente no code-behind (ver
        ScreenOutputWindow.xaml.cs), não uma ViewModel própria — não há nada aqui que precise de
        MVVM, é puramente um "monitor de vídeo" renderizado.

        Stretch="Uniform" (preserva proporção, "Letterbox") é a decisão do usuário (pergunta
        "Enquadramento" da Sprint Telas-Saida-Direta) — a imagem nunca é cortada nem distorcida pra
        caber na tela, barras pretas (o Background acima) preenchem o resto.
    -->
    <Grid Background="Black">
        <Image x:Name="DisplayImage" Stretch="Uniform" />
    </Grid>
</Window>
