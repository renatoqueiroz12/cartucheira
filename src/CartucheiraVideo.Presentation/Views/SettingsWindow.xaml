<Window x:Class="CartucheiraVideo.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CartucheiraVideo.Presentation.Views"
        Title="Configurações — Cartucheira Vídeo"
        Height="640" Width="720"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <!--
        Sprint Config Geral, parte 1 (2026-08-09) — janela ÚNICA de Configurações, não-modal
        (decisão do usuário: "abre em outra aba e nao fecha o software"). Substitui o antigo
        DeckSettingsWindow (uma janela modal por Deck, aberta pela engrenagem de cada card) por uma
        janela só, com navegação lateral.

        Sprint Cartucheira (2026-08-09, parte 2 do item 2 do roteiro): terceira entrada na sidebar —
        "Cartucheira", ao lado de "Deck 1"/"Deck 2" — mesmo padrão de Visibility por Border externo.

        Sprint Livewire-2 (2026-09-13): quarta entrada — "Saídas Livewire". Sprint NDI-Placa-de-Rede
        (2026-09-13, mesmo dia): quinta entrada — "Rede NDI" — mesmo padrão de Visibility.

        Sprint Arte-de-Fundo (2026-11-10): sexta entrada — "Arte de Fundo" (BackgroundArtSettingsPanel)
        — mesmo padrão de Visibility das anteriores.

        Rodapé único (Salvar/Fechar) — diferente do antigo diálogo por Deck, Salvar aqui NÃO fecha a
        janela: aplica e persiste os três painéis de uma vez (SettingsViewModel.SaveCommand) e deixa
        o operador continuar ajustando. Fechar (code-behind) só fecha, sem desfazer nada que já
        tenha sido salvo antes.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Theme.SettingsNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLow}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHi}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Bg2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegação lateral — Deck 1/Deck 2/Cartucheira. -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bg3}">
                <StackPanel Margin="10,16">
                    <Button Content="Deck 1" Command="{Binding SelectDeck1Command}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeck1Selected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Deck 2" Command="{Binding SelectDeck2Command}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeck2Selected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cartucheira" Command="{Binding SelectCartridgesCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCartridgesSelected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Saídas Livewire" Command="{Binding SelectLivewireOutputsCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLivewireOutputsSelected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Rede NDI" Command="{Binding SelectNdiNetworkCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNdiNetworkSelected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Arte de Fundo" Command="{Binding SelectBackgroundArtCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Theme.SettingsNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackgroundArtSelected}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!--
                Conteúdo — um painel por seção, alternando por Visibility (mesmo padrão de abas do
                próprio DeckSettingsPanel). Visibility fica no Border externo (DataContext herdado
                da janela, SettingsViewModel) — só o painel de dentro troca de DataContext pro
                ViewModel da seção específica.
            -->
            <Grid Grid.Column="1" Margin="20">
                <Border Visibility="{Binding IsDeck1Selected, Converter={StaticResource BoolToVis}}">
                    <views:DeckSettingsPanel DataContext="{Binding Deck1Settings}" />
                </Border>
                <Border Visibility="{Binding IsDeck2Selected, Converter={StaticResource BoolToVis}}">
                    <views:DeckSettingsPanel DataContext="{Binding Deck2Settings}" />
                </Border>
                <Border Visibility="{Binding IsCartridgesSelected, Converter={StaticResource BoolToVis}}">
                    <views:CartridgeSettingsPanel DataContext="{Binding CartridgeSettings}" />
                </Border>
                <Border Visibility="{Binding IsLivewireOutputsSelected, Converter={StaticResource BoolToVis}}">
                    <views:LivewireOutputsSettingsPanel DataContext="{Binding LivewireOutputsSettings}" />
                </Border>
                <Border Visibility="{Binding IsNdiNetworkSelected, Converter={StaticResource BoolToVis}}">
                    <views:NdiNetworkSettingsPanel DataContext="{Binding NdiNetworkSettings}" />
                </Border>
                <Border Visibility="{Binding IsBackgroundArtSelected, Converter={StaticResource BoolToVis}}">
                    <views:BackgroundArtSettingsPanel DataContext="{Binding BackgroundArtSettings}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Rodapé único — Salvar aplica+persiste sem fechar; Fechar só fecha (code-behind), descartando o que não foi salvo. -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Bg3}" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" Width="100" Padding="8" Margin="0,0,8,0" Click="Close_Click" />
                <Button Content="Salvar" Width="100" Padding="8" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
